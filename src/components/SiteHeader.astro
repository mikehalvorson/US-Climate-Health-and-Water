---
import { hrefForRoute, primaryNavigationFor } from '../lib/navigation/shell';
import type { RouteDefinition } from '../lib/registry/types';

interface Props { route: RouteDefinition }
const { route } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = primaryNavigationFor(route);
---
<header class="site-header">
  <div class="system-stripe" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="site-header__identity">
    <a class="product-mark" href={hrefForRoute('/', base)} aria-label="U.S. Climate, Health & Water overview">
      <span class="product-mark__name">U.S. Climate, Health &amp; Water</span>
      <span class="product-mark__purpose">Evidence for resilient essential systems</span>
    </a>
    <div class="header-tools">
      <span class="vintage-indicator"><span aria-hidden="true"></span> Evidence through Aug 2026</span>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark theme">
        <span class="theme-toggle__icon" aria-hidden="true"></span>
        <span data-theme-label>Light</span>
      </button>
    </div>
  </div>
  <div class="primary-nav-shell">
    <details>
      <summary>Explore the dashboard <span aria-hidden="true">+</span></summary>
      <nav class="primary-nav" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a
            href={hrefForRoute(item.path, base)}
            class:list={{ 'is-active': item.active }}
            aria-current={item.active ? 'page' : undefined}
            data-route-id={item.id}
          >{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
