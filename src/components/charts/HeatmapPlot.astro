---
import { buildHeatmapGeometry, numericExtent, type HeatmapInput } from '../../lib/charts/geometry';

interface Props {
  id: string;
  values: readonly HeatmapInput[];
  rows: readonly string[];
  columns: readonly string[];
  unit: string;
  summary: string;
  variant?: 'heatmap' | 'matrix';
  width?: number;
  height?: number;
}

const { id, values, rows, columns, unit, summary, variant = 'heatmap', width = 720, height = 420 } = Astro.props;
const geometry = buildHeatmapGeometry(values, rows, columns, { width, height, insets: { top: 48, left: 110 } });
const domain = numericExtent(values.map((item) => item.value), { padding: 0 });
const intensity = (value: number | null) => value === null ? 0 : Math.max(0, Math.min(1, (value - domain[0]) / (domain[1] - domain[0])));
const missingPatternId = `${id}-missing-cell-pattern`;
---
<svg class:list={['svg-plot', 'heatmap-plot', `heatmap-plot--${variant}`]} viewBox={`0 0 ${width} ${height}`} role="img" aria-label={summary}>
  <title>{summary}</title>
  <defs><pattern id={missingPatternId} width="8" height="8" patternUnits="userSpaceOnUse"><path d="M -2 2 L 2 -2 M 0 8 L 8 0 M 6 10 L 10 6" /></pattern></defs>
  {columns.map((column, index) => <text class="heatmap-column-label" x={110 + (width - 128) / columns.length * (index + 0.5)} y="38" text-anchor="middle">{column}</text>)}
  {rows.map((row, index) => <text class="heatmap-row-label" x="102" y={48 + (height - 84) / rows.length * (index + 0.5)} text-anchor="end" dominant-baseline="middle">{row}</text>)}
  {geometry.map((cell) => {
    const tooltip = cell.missing ? `${cell.row}, ${cell.column}: missing` : `${cell.row}, ${cell.column}: ${cell.value} ${unit}`;
    return <rect class:list={['heatmap-cell', { 'is-missing': cell.missing }]} x={cell.x} y={cell.y} width={cell.width} height={cell.height} style={cell.missing ? `--missing-pattern:url(#${missingPatternId})` : `--cell-opacity:${0.18 + intensity(cell.value) * 0.72}`} tabindex="0" aria-label={tooltip} data-tooltip={tooltip}><title>{tooltip}</title></rect>;
  })}
</svg>
