---
import { chapterNavigationFor, hrefForRoute, narrativeProgress } from '../lib/navigation/shell';
import type { RouteDefinition } from '../lib/registry/types';

interface Props { route: RouteDefinition }
const { route } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = chapterNavigationFor(route);
---
<div class="chapter-navigation-wrap">
  {navigation.mechanisms.length > 0 && (
    <aside class="mechanism-links" aria-labelledby="mechanism-title">
      <p id="mechanism-title">Continue the mechanism</p>
      {navigation.mechanisms.map((link) => (
        <a href={hrefForRoute(link.route.path, base)}>{link.label} <span aria-hidden="true">↗</span></a>
      ))}
    </aside>
  )}
  {(navigation.previous || navigation.next) && (
    <nav class="chapter-nav" aria-label="Chapter navigation">
      <p>Walk the full story · {narrativeProgress(route)}</p>
      <div>
        {navigation.previous ? (
          <a class="chapter-nav__previous" href={hrefForRoute(navigation.previous.path, base)} rel="prev">
            <span>← Back</span><strong>{navigation.previous.label}</strong>
          </a>
        ) : <span></span>}
        {navigation.next ? (
          <a class="chapter-nav__next" href={hrefForRoute(navigation.next.path, base)} rel="next">
            <span>Next →</span><strong>{navigation.next.label}</strong>
          </a>
        ) : <span></span>}
      </div>
    </nav>
  )}
</div>
