---
import DotRangePlot from '../charts/DotRangePlot.astro';
import CaveatPanel from '../CaveatPanel.astro';
import ChartFrame from '../ChartFrame.astro';
import DataTable from '../DataTable.astro';
import EvidenceGap from '../EvidenceGap.astro';
import OptionComparison from '../OptionComparison.astro';
import RecommendationPanel from '../RecommendationPanel.astro';
import ViewpointGrid from '../ViewpointGrid.astro';
import FrameworkFigure from '../strategy/FrameworkFigure.astro';
import StrategyWorkbench from '../strategy/StrategyWorkbench.astro';
import { approvedStrategyChart, CLIMATE_PLAN_WARMING_RANGES, CLIMATE_PLAN_WARMING_TABLE, CLIMATE_PLAN_WORKBENCH, STRATEGY_SOURCES, strategyGap } from '../../lib/data/strategy';

const warmingChart = approvedStrategyChart('climate-plan-source-scenarios', 'dot_range');
const damageGap = strategyGap('GAP-CLIM-010');
const sources = STRATEGY_SOURCES.climate;
---
<article class="chapter-content" data-chapter-content="climate-plan">
  <section id="current-system" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">01 · Current system</p><h2>Mitigation changes future hazard; adaptation changes exposure and vulnerability</h2><p>A durable climate plan joins both while tracking residual risk. Lower emissions limit added warming across systems; adaptation protects people, ecosystems, and essential services against current and future conditions.</p></div>
    <FrameworkFigure chartId="climate-plan-causal-map" chartType="causal_path" unit="Causal and decision relationship; no damage total" geography="Global climate with place-specific risk and adaptation" period="Observed change, assessed pathways, and long-lived decisions" sources={sources} summary="Emissions influence concentrations, forcing, warming, and hazards; exposure and vulnerability shape consequences; mitigation, adaptation, and recovery intervene at different points." items={[
      { label: 'Emissions and removals', value: 'Mitigation entry point', state: 'Causal evidence', detail: 'Energy, industry, transport, buildings, land, agriculture, waste, and removals influence atmospheric forcing.', gate: 'Gas-specific inventories, policies, delivery, and permanence' },
      { label: 'Warming and climate response', value: 'Assessed ranges', state: 'Source scenarios', detail: 'The climate system converts forcing into warming and other changes with uncertainty and time lags.', gate: 'Keep scenario, baseline, period, model, and uncertainty explicit' },
      { label: 'Hazards', value: 'Risk-specific', state: 'Assessed evidence', detail: 'Heat, heavy precipitation, drought, fire weather, sea level, ocean change, and other hazards respond differently.', gate: 'Hazard-specific evidence and local credibility' },
      { label: 'Exposure and vulnerability', value: 'Place and population', state: 'Incomplete baseline', detail: 'People, assets, ecosystems, poverty, health, housing, infrastructure, and governance shape consequences.', gate: 'Current local, demographic, asset, service, and ecological layers' },
      { label: 'Adaptation and resilience', value: 'Risk-reduction entry point', state: 'Place-specific', detail: 'Standards, services, ecosystems, infrastructure, preparedness, finance, protection, accommodation, and transition reduce risk.', gate: 'Performance, limits, maintenance, authority, and equity evidence' },
      { label: 'Residual risk and loss', value: null, state: 'Always retained', detail: 'Some disruption, irreversible loss, adaptation limits, surprise, and compound failure remain.', gate: 'Scenario-specific residuals; no unsupported national damage total' },
    ]} />
    <ChartFrame chart={warmingChart} unit="Degrees Celsius above 1850–1900" geography="Global mean surface temperature" period="2081–2100 assessed twenty-year mean" sources={sources} summary="Five IPCC pathways span lower to much higher late-century warming. Each point is a best estimate with a visible very-likely range; none is assigned a forecast probability." caveats={['Twenty-year assessment periods are not invented annual trajectories.', 'Global warming does not directly produce local damages or project design conditions.']}>
      <DotRangePlot slot="plot" values={CLIMATE_PLAN_WARMING_RANGES} valueLabel="Assessed global warming" unit="°C" summary="Best estimates and very likely ranges for global warming in 2081–2100 under five SSP pathways." labelWidth={150} width={820} height={360} />
      <DataTable slot="table" caption="Assessed late-century warming under five source scenarios" columns={[{ key: 'scenario', label: 'Scenario' }, { key: 'period', label: 'Period' }, { key: 'bestEstimate', label: 'Best estimate', unit: '°C', numeric: true }, { key: 'veryLikelyLow', label: 'Very likely low', unit: '°C', numeric: true }, { key: 'veryLikelyHigh', label: 'Very likely high', unit: '°C', numeric: true }, { key: 'baseline', label: 'Baseline' }]} rows={CLIMATE_PLAN_WARMING_TABLE} />
    </ChartFrame>
  </section>

  <section id="problems" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">02 · Why this is a problem</p><h2>One pathway does not define one local risk or one adaptation package</h2><p>Hazard, exposure, vulnerability, adaptation performance, compound events, and institutional capacity vary. Long-lived assets must remain safe under conditions more severe than the emissions target alone would suggest.</p></div>
    <FrameworkFigure chartId="climate-plan-adaptation-packages" chartType="matrix" unit="Risk-to-responsibility mapping; no universal project rank" geography="United States national-to-local implementation" period="Current climate through long-lived asset horizons" sources={sources} summary="Adaptation packages follow the risk and the responsible service system while retaining local evidence gates." items={[
      { label: 'Extreme heat', value: 'Health, labor, buildings, power', state: 'High priority', detail: 'Warnings, cooling access, worker standards, passive survivability, trees, grid reliability, and health-system continuity.', gate: 'Local heat, exposure, health, housing, power, and maintenance data' },
      { label: 'Flood and heavy precipitation', value: 'Land, drainage, buildings, transport', state: 'High priority', detail: 'Avoidance, updated standards, drainage, floodplain restoration, protection, insurance, continuity, and recovery.', gate: 'Local precipitation, hydrology, drainage, exposure, and future-development scenarios' },
      { label: 'Drought and water stress', value: 'Basins, utilities, farms, ecosystems', state: 'High priority', detail: 'Demand, repair, operations, environmental flows, storage, reuse, allocation, and suitable supply.', gate: 'Basin water quantity, quality, rights, ecology, demand, and live conditions' },
      { label: 'Coastal change', value: 'Communities, ecosystems, infrastructure', state: 'High priority', detail: 'Protection, accommodation, restoration, land-use change, voluntary transition, and receiving-community capacity.', gate: 'Local relative sea level, flood thresholds, dependencies, finance, and community authority' },
      { label: 'Food and ecosystems', value: 'Production, access, habitat, land', state: 'High priority', detail: 'Resilient crops and practices, water stewardship, diversity, worker protection, supply chains, access, and conservation.', gate: 'Common crop, water, land, trade, price, nutrition, labor, and biodiversity scenarios' },
      { label: 'Compound service failure', value: 'Cross-infrastructure', state: 'Stress test', detail: 'Backup power, communications, mutual aid, redundancy, emergency service, restoration, and adaptive pathways.', gate: 'Geospatial dependency, outage, critical-user, recovery, and governance model' },
    ]} />
    <ViewpointGrid id="climate-plan-viewpoints" title="Climate risk and decision authority are unevenly distributed" items={[
      { viewpoint: 'people_and_households', label: 'People and households', problem: 'Income, health, age, disability, housing, insurance, mobility, race, and geography shape exposure and recovery.', evidenceState: 'qualitative_evidence', consequence: 'Protection, affordability, access, relocation support, and procedural fairness must be measured outcomes.' },
      { viewpoint: 'host_communities_and_tribes', label: 'Communities and Tribes', problem: 'Cultural resources, sovereignty, subsistence, land, waters, and place attachment can be lost or transformed.', evidenceState: 'qualitative_evidence', consequence: 'Community authority, free prior processes where applicable, and self-determined pathways are essential.' },
      { viewpoint: 'utilities_and_infrastructure_owners', label: 'Essential-service providers', problem: 'Assets interact across power, water, transport, communications, health, housing, and supply chains.', evidenceState: 'data_gap', consequence: 'Stress tests must include cross-system dependencies and restoration, not hazard exposure alone.' },
      { viewpoint: 'future_generations', label: 'Future generations', problem: 'Current emissions and land, infrastructure, and settlement choices shape long-lived hazard and lock-in.', evidenceState: 'source_scenario', consequence: 'Lower warming and adaptable investments preserve options, but residual and irreversible losses remain.' },
    ]} />
  </section>

  <section id="choices" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">03 · Choices</p><h2>Mitigation levers and adaptation systems must advance in parallel</h2></div>
    <OptionComparison id="climate-plan-options" title="Three climate-plan postures under the same decision dimensions" question="How should a plan manage both cumulative warming and current vulnerability?" dimensions={[{ id: 'hazard', label: 'Future hazard' }, { id: 'current', label: 'Current risk' }, { id: 'delivery', label: 'Delivery need' }, { id: 'limit', label: 'Limit' }, { id: 'evidence', label: 'Evidence boundary' }]} options={[
      { id: 'mitigation-only', label: 'Mitigation only', summary: 'Focus on lowering emissions and removals.', values: { hazard: 'Limits added long-term hazard', current: 'Leaves current exposure and vulnerability', delivery: 'Economy-wide transition', limit: 'Committed and present risks continue', evidence: 'Cannot substitute for local adaptation' } },
      { id: 'adaptation-only', label: 'Adaptation only', summary: 'Focus on protection and resilience.', values: { hazard: 'Does not limit escalating global hazard', current: 'Can reduce near-term risk', delivery: 'Place-specific services and assets', limit: 'Adaptation limits and residual loss rise', evidence: 'Performance is local and risk-specific' } },
      { id: 'robust', label: 'Lowest feasible emissions plus high stress test', summary: 'Mitigate low and adapt high.', values: { hazard: 'Pursues lowest feasible pathway', current: 'Protects essential systems now', delivery: 'National-to-local coordination', limit: 'Residual and irreversible risk remains', evidence: 'Recommended framework; not a cost-benefit optimum' } },
    ]} />
    <FrameworkFigure chartId="climate-plan-mitigation-levers" chartType="matrix" unit="Lever, system, and delivery relationship; no marginal-abatement ranking" geography="United States action with global climate effect" period="Immediate action through net emissions decline and durable removals" sources={sources} summary="Mitigation levers operate through different physical systems, institutions, lead times, and non-climate constraints." items={[
      { label: 'Efficient clean energy', value: 'CO₂ and co-pollutant pathway', state: 'Core lever', detail: 'Efficiency, electrification, clean electricity, fuels, grids, storage, and industrial change.', gate: 'Energy service, reliability, delivery, land, water, material, health, and equity evidence' },
      { label: 'Methane and other short-lived pollutants', value: 'Near-term forcing pathway', state: 'Core lever', detail: 'Oil and gas, waste, agriculture, refrigerants, measurement, repair, substitution, and enforcement.', gate: 'Gas- and source-specific inventories, lifetimes, leakage, and verification' },
      { label: 'Land and ecosystems', value: 'Avoided emissions plus sinks', state: 'Core lever', detail: 'Protect and restore forests, soils, wetlands, grasslands, coasts, and biodiversity while respecting food and rights.', gate: 'Additionality, permanence, leakage, ecology, tenure, and community evidence' },
      { label: 'Materials and circular systems', value: 'Demand and process pathway', state: 'Supporting lever', detail: 'Service efficiency, durability, reuse, repair, recycling, substitution, and low-emission production.', gate: 'Functional units, lifecycle boundaries, safety, quality, and rebound' },
      { label: 'Carbon removal', value: 'Residual-emissions pathway', state: 'Conditional lever', detail: 'Durable biological, geochemical, or engineered removals may address residual emissions.', gate: 'Durability, measurement, additionality, energy, land, water, cost, and liability' },
      { label: 'Finance, standards, and institutions', value: 'Delivery pathway', state: 'Enabling lever', detail: 'Public investment, procurement, regulation, markets, disclosure, research, workforce, participation, and international coordination.', gate: 'Authority, enforcement, distribution, delivery, monitoring, and revision' },
    ]} />
  </section>

  <section id="recommendation" class="chapter-act" data-chapter-section>
    <RecommendationPanel id="climate-plan-recommendation" title="Pursue low warming while protecting against severe local conditions" conclusion="Pursue the lowest feasible emissions pathway while stress-testing essential services and long-lived assets against more severe locally credible conditions." rationale={['Lower cumulative emissions reduce added hazard across people, ecosystems, and systems.', 'Current exposure and vulnerability require adaptation even under the lowest pathway.', 'High-end locally credible stress tests protect long-lived decisions from false precision in one central scenario.']} tradeoffs={['Rapid mitigation and adaptation require sustained finance, institutional capacity, and difficult siting and distribution choices', 'Designing for severe conditions can add cost or constrain near-term development', 'Some protection strategies can transfer risk, induce maladaptation, or harm ecosystems and communities']} residualRisks={['Irreversible losses, adaptation limits, compound events, surprises, and cascading service failures', 'Emissions or delivery pathways that miss their targets', 'Unequal protection, displacement, debt, insurance withdrawal, and burdens that integrated damage totals would hide']} />
    <FrameworkFigure chartId="climate-plan-residual-risk" chartType="matrix" unit="Qualitative residual-risk state; no damage estimate or scenario probability" geography="Global hazard with local essential-service consequences" period="Near-term, mid-century, and late-century planning" sources={sources} summary="Lower, central, and severe conditions change the scale of adaptation and residual risk, but none removes the need for monitored protection and revision." items={[
      { label: 'Lower condition', value: 'Lower added hazard', state: 'Planning condition', detail: 'Continue mitigation, close present adaptation deficits, protect ecosystems, and avoid new exposure.', gate: 'Local observations, lower-pathway hazard, vulnerability, and adaptation performance' },
      { label: 'Central condition', value: 'Escalating compound risk', state: 'Planning condition', detail: 'Scale standards, services, infrastructure, finance, ecosystem restoration, and adaptive pathways.', gate: 'Multi-hazard and cross-system stress validation' },
      { label: 'Severe condition', value: 'Adaptation limits more likely', state: 'Stress condition', detail: 'Protect minimum service, plan for failure and recovery, preserve retreat or transformation options, and identify intolerable risk.', gate: 'Locally credible high-end hazards, dependencies, thresholds, and community decisions' },
      { label: 'Residual across all conditions', value: null, state: 'Explicit outcome', detail: 'Mortality, illness, disruption, ecosystem loss, cultural loss, displacement, cost, and irreversible change cannot be collapsed here.', gate: 'Outcome-specific evidence, uncertainty, distribution, and no universal coefficient' },
    ]} />
  </section>

  <section id="model" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">05 · Model-supported case</p><h2>The robust-decision model contract preserves uncertainty and local responsibility</h2></div>
    <StrategyWorkbench config={CLIMATE_PLAN_WORKBENCH} sources={sources} />
    <FrameworkFigure chartId="climate-plan-model-contract" chartType="flow" unit="Versioned robust-decision contract; integrated damages unavailable" geography="Global climate scenarios joined only to validated local risk layers" period="Observed calibration and explicit decision horizons" sources={sources} summary="The model contract connects source scenarios to hazards, exposure, vulnerability, adaptation actions, performance, costs, distribution, thresholds, and residual risk without authorizing a national damage total." items={[
      { label: 'Source scenarios', value: 'Versioned families', state: 'Required', detail: 'Emissions, concentrations, warming, sea level, and hazard ensembles retain model, baseline, period, and uncertainty.', gate: 'No splicing, invented annual values, or probability labels' },
      { label: 'Local risk inputs', value: 'Hazard × exposure × vulnerability', state: 'Required', detail: 'People, ecosystems, assets, services, dependencies, health, housing, income, governance, and current adaptation.', gate: 'Geospatial and demographic provenance with uncertainty' },
      { label: 'Actions and response', value: 'Mitigation and adaptation modules', state: 'Required', detail: 'Costs, lead times, performance ranges, interactions, maintenance, limits, failure modes, and distribution.', gate: 'Empirical or model-validated response functions' },
      { label: 'Decision outputs', value: null, state: 'Unavailable', detail: 'Robustness, thresholds, regret, distribution, residual risk, service continuity, and pathway triggers remain multi-dimensional.', gate: 'No integrated national damage or benefit-cost total' },
      { label: 'Validation and release', value: 'Backtest, stress, audit', state: 'Blocked', detail: 'Historical events, observed performance, sensitivity, out-of-sample regions, stakeholder review, reproducibility, and versioning.', gate: 'Close linked gaps and publish known failure modes' },
    ]} />
    <EvidenceGap item={damageGap} decision="Estimate outcome-specific climate consequences and adaptation performance without unsupported universal coefficients." missingInputs={['Validated local hazard, exposure, vulnerability, and adaptation-response layers', 'Outcome-specific health, service, ecosystem, displacement, and distribution models', 'Common scenarios, uncertainty propagation, backtesting, and decision thresholds']} />
    <CaveatPanel title="This is a robust-decision framework, not a national cost-benefit solution" caveats={['The working view combines assessed global ranges with qualitative, risk-specific response logic only.', 'Severe stress conditions are planning tests, not assigned forecast probabilities.', 'No integrated damage total is authorized.']} prohibitedInterpretations={['An integrated national climate-damage total or optimized mitigation-adaptation split.', 'Global warming converted directly into local deaths, costs, hurricanes, freshwater loss, food insecurity, or refugees.', 'A central scenario used as the sole design condition for long-lived assets.']} />
  </section>

  <section id="delivery" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">06 · Delivery</p><h2>Mitigate low, adapt high, monitor, and revise</h2></div>
    <FrameworkFigure chartId="climate-plan-roadmap" chartType="flow" unit="Decision phase and evidence gate; no optimized schedule" geography="United States national-to-local action within global cooperation" period="Immediate protection through long-term adaptive pathways" sources={sources} summary="The roadmap cuts emissions rapidly, closes present adaptation deficits, stress-tests long-lived decisions, and revises through monitored thresholds." items={[
      { label: 'Cut emissions and no-regrets vulnerability now', value: 'Immediate', state: 'Phase 1', detail: 'Energy transition, methane control, ecosystem protection, heat safety, warnings, service continuity, preparedness, and avoided new exposure.', gate: 'Delivery owners, finance, participation, baselines, and near-term performance' },
      { label: 'Scale system transitions and adaptation', value: 'This decade and next', state: 'Phase 2', detail: 'Buildings, transport, industry, land, grids, water, health, housing, food, coasts, ecosystems, and finance move through regional pathways.', gate: 'Sector and place models, standards, workforce, infrastructure, and distributional review' },
      { label: 'Stress-test long-lived decisions', value: 'Before lock-in', state: 'Phase 3', detail: 'Test severe locally credible heat, water, flood, fire, sea-level, compound, outage, and recovery conditions.', gate: 'Hazard, dependency, threshold, failure, recovery, and adaptation-limit evidence' },
      { label: 'Monitor and revise', value: 'Continuous', state: 'Adaptive phase', detail: 'Track emissions, warming, hazards, exposure, vulnerability, project performance, service, ecosystems, distribution, and residual risk.', gate: 'Public indicators, triggers, independent audit, stop/go decisions, and version history' },
    ]} />
    <div class="delivery-gates"><article><h3>Mitigation gate</h3><p>Measured emissions, delivery, lifecycle burdens, removals durability, and distribution.</p></article><article><h3>Adaptation gate</h3><p>Local risk, performance, maintenance, limits, transferred risk, and community authority.</p></article><article><h3>Revision gate</h3><p>Observed thresholds, model error, new evidence, failure, inequity, ecosystem harm, and path dependency.</p></article></div>
  </section>
</article>
