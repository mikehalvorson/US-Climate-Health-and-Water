---
import CaveatPanel from '../CaveatPanel.astro';
import EvidenceGap from '../EvidenceGap.astro';
import OptionComparison from '../OptionComparison.astro';
import RecommendationPanel from '../RecommendationPanel.astro';
import ViewpointGrid from '../ViewpointGrid.astro';
import FrameworkFigure from '../strategy/FrameworkFigure.astro';
import StrategyWorkbench from '../strategy/StrategyWorkbench.astro';
import { FOOD_WATER_PLAN_WORKBENCH, STRATEGY_SOURCES, strategyGap } from '../../lib/data/strategy';

const basinGap = strategyGap('GAP-CLIM-005');
const equityGap = strategyGap('WGAP-EQUITY');
const sources = STRATEGY_SOURCES.foodWater;
---
<article class="chapter-content" data-chapter-content="food-water-plan">
  <section id="current-system" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">01 · Current system</p><h2>Essential services share basins, infrastructure, energy, materials, and institutions</h2><p>Households, farms, food systems, industry, power, cities, Tribes, and ecosystems draw on connected sources and infrastructure. A reliable portfolio must preserve quantity, quality, timing, rights, affordability, and ecological function together.</p></div>
    <FrameworkFigure chartId="food-water-plan-system-map" chartType="flow" unit="System dependency; no nationalized basin balance" geography="United States basins, aquifers, utilities, food systems, and facilities" period="Current operations and planning horizons" sources={sources} summary="Basins and aquifers connect ecosystems and rights to utilities, agriculture, food, energy, industry, households, and return flows through shared infrastructure and governance." items={[
      { label: 'Climate, basin, aquifer, and ecosystems', value: 'Physical boundary', state: 'Place-specific', detail: 'Runoff, recharge, snow, drought, flood, quality, storage, environmental flows, habitat, and source interactions set constraints.', gate: 'Harmonized basin scenarios and monitoring' },
      { label: 'Rights, governance, and finance', value: 'Institutional boundary', state: 'Place-specific', detail: 'Federal, state, Tribal, interstate, local, utility, district, private, and community authorities allocate risk and resources.', gate: 'Verified authority, rights, compacts, permits, rate, and funding data' },
      { label: 'Utilities and shared infrastructure', value: 'Delivery boundary', state: 'Partial evidence', detail: 'Intakes, wells, conveyance, storage, treatment, distribution, wastewater, stormwater, power, and communications enable service.', gate: 'Asset condition, capacity, dependencies, operations, and failure data' },
      { label: 'Food and agriculture', value: 'Major consumptive-use link', state: 'Partial evidence', detail: 'Irrigation, crops, livestock, processing, labor, markets, nutrition, and ecosystems interact with water and energy.', gate: 'Crop-basin-market-household model' },
      { label: 'Energy, industry, and materials', value: 'Facility and upstream link', state: 'Partial evidence', detail: 'Cooling, process water, quality, discharge, power, fuels, products, supply chains, and siting create local dependencies.', gate: 'Verified facility, source, return-flow, quality, and operating data' },
      { label: 'People and ecosystems', value: 'Essential outcomes', state: 'Joint constraint', detail: 'Safe affordable service, health, livelihoods, cultural uses, Tribal rights, habitat, and downstream conditions must be protected.', gate: 'Distributional, service, rights, quality, and ecological measures' },
    ]} />
    <FrameworkFigure chartId="food-water-plan-outcomes" chartType="matrix" unit="Decision requirement; no achieved-outcome score" geography="Basin and service-area decisions" period="Normal, drought, growth, failure, and recovery" sources={sources} summary="Essential human outcomes and ecological constraints are simultaneous portfolio gates rather than tradeable entries in one national score." items={[
      { label: 'Safe minimum household service', value: 'Non-negotiable outcome', state: 'Essential', detail: 'Drinking, cooking, hygiene, sanitation, cooling, health care, and emergency use remain safe and accessible.', gate: 'Quantity, quality, reliability, access, affordability, and shutoff data' },
      { label: 'Food and livelihood continuity', value: 'Protected outcome', state: 'Essential', detail: 'Agricultural and food-system transition must distinguish physical output, producer income, worker safety, access, and nutrition.', gate: 'Regional crop, water, labor, market, price, and nutrition evidence' },
      { label: 'Critical infrastructure and industry', value: 'Prioritized service', state: 'Conditional', detail: 'Health, safety, grid, communications, wastewater, firefighting, and critical production need explicit priorities and alternatives.', gate: 'Critical-load, facility, dependency, water-balance, and recovery evidence' },
      { label: 'Water quality and public health', value: 'Joint constraint', state: 'Release blocking', detail: 'A physically present volume is not usable without source and finished-water quality and treatment capability.', gate: 'Contaminant, discharge, treatment, monitoring, and incident layers' },
      { label: 'Environmental flows and ecosystem function', value: 'Joint constraint', state: 'Release blocking', detail: 'Habitat, temperature, salinity, connectivity, wetlands, species, and downstream communities need enforceable protection.', gate: 'Ecological thresholds, seasonal flows, quality, and monitoring' },
      { label: 'Equity, rights, and procedural justice', value: 'Joint constraint', state: 'Release blocking', detail: 'Affordability, Tribal rights, rural wells, farmworkers, small utilities, cumulative burden, participation, and benefit distribution remain visible.', gate: 'Comparable distributional data and community authority' },
    ]} />
  </section>

  <section id="problems" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">02 · Why this is a problem</p><h2>Supply projects cannot repair fragmented demand, losses, operations, quality, ecosystems, or governance</h2><p>Nor can demand programs alone guarantee essential service under severe drought, rapid growth, contamination, or infrastructure failure. Portfolios need multiple contribution types with boundaries that stay local and compatible.</p></div>
    <FrameworkFigure chartId="food-water-plan-contributions" chartType="bar" unit="Contribution class; compatible national quantities unavailable" geography="Basin, utility, farm, facility, and household portfolios" period="Near-term operations through long-lived infrastructure" sources={sources} summary="Demand, repair, reuse, operations, ecosystems, storage, and suitable new supply form a sequence. Their source-native case evidence cannot be added into one national water-saved total." items={[
      { label: 'Demand and service efficiency', value: null, state: 'Portfolio contribution', detail: 'Reduce avoidable use while protecting essential service and tracking rebound, return flow, and distribution.', gate: 'Sector, season, service, baseline, counterfactual, and equity evidence' },
      { label: 'Leak repair and asset renewal', value: null, state: 'Portfolio contribution', detail: 'Repair loss and improve condition, metering, pressure, quality, and outage performance.', gate: 'Utility water balance, asset condition, cost, and verified loss reduction' },
      { label: 'Fit-for-purpose reuse', value: null, state: 'Portfolio contribution', detail: 'Match source, treatment, storage, conveyance, quality, user, energy, and discharge conditions.', gate: 'Project-specific water balance, quality, demand, and reliability evidence' },
      { label: 'Operations and allocation', value: null, state: 'Portfolio contribution', detail: 'Use forecasting, storage, transfers, conjunctive use, drought stages, priorities, and recovery rules.', gate: 'Live conditions, rights, environmental floors, operations, and enforceability' },
      { label: 'Ecosystem protection and restoration', value: null, state: 'Portfolio contribution', detail: 'Protect sources, floodplains, wetlands, recharge, environmental flows, water quality, habitat, and natural storage.', gate: 'Local performance, permanence, land, rights, maintenance, and climate evidence' },
      { label: 'Storage and suitable new supply', value: null, state: 'Conditional contribution', detail: 'Evaluate surface, groundwater, recharge, desalination, imports, rain, stormwater, and other supplies after earlier layers.', gate: 'Reliable yield, quality, energy, emissions, brine, ecology, cost, rights, and delivery' },
    ]} caveats={['Null contribution quantities are deliberate because common baselines, geographies, periods, and return-flow methods are absent.', 'Case-study technology yields are not national portfolio quantities.']} />
    <ViewpointGrid id="food-water-plan-viewpoints" title="Fragmentation shifts risk between users and places" items={[
      { viewpoint: 'people_and_households', label: 'Households', problem: 'Capital, drought, quality, and growth costs can raise bills or reduce service, especially for low-income customers and renters.', evidenceState: 'data_gap', consequence: 'Minimum service, affordability, shutoff protection, assistance, and transparent cost allocation are required.' },
      { viewpoint: 'businesses_and_producers', label: 'Farms and businesses', problem: 'Allocation, quality, reliability, permits, rates, infrastructure, and transition affect output and livelihoods.', evidenceState: 'qualitative_evidence', consequence: 'Predictable rules, conservation support, risk sharing, transition aid, and performance accountability matter.' },
      { viewpoint: 'host_communities_and_tribes', label: 'Communities and Tribes', problem: 'Projects and transfers can affect rights, culture, housing, wells, local service, land, and cumulative burdens.', evidenceState: 'data_gap', consequence: 'Authority, rights, early participation, alternatives, benefits, and enforceable protections are portfolio gates.' },
      { viewpoint: 'ecosystems_and_nonhuman_life', label: 'Ecosystems and downstream users', problem: 'Withdrawal, consumption, storage, temperature, chemistry, salinity, timing, and location change habitat and downstream availability.', evidenceState: 'qualitative_evidence', consequence: 'Environmental flows and quality are constraints, not residual uses after allocation.' },
    ]} />
  </section>

  <section id="choices" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">03 · Choices</p><h2>Compare portfolio families against the same stresses and tradeoffs</h2></div>
    <OptionComparison id="food-water-plan-options" title="Four portfolio families under common essential-service dimensions" question="Which approach manages service, drought, growth, failure, ecology, and distribution without hiding basin differences?" dimensions={[{ id: 'service', label: 'Service reliability' }, { id: 'cost', label: 'Cost and delivery' }, { id: 'ecology', label: 'Ecology and quality' }, { id: 'equity', label: 'Equity and rights' }, { id: 'residual', label: 'Residual risk' }]} options={[
      { id: 'fragmented', label: 'Fragmented programs', summary: 'Separate agencies pursue separate projects.', values: { service: 'Cross-system gaps persist', cost: 'Duplicated or mis-sequenced investment', ecology: 'Cumulative effects obscured', equity: 'Cost and failure can be shifted', residual: 'High compound and governance risk' } },
      { id: 'supply', label: 'Supply only', summary: 'Expand physical water sources and capacity.', values: { service: 'Can add selected capacity', cost: 'High capital, energy, permitting, and lead time', ecology: 'Source, brine, conveyance, emissions, and growth effects', equity: 'Large cost-allocation and siting choices', residual: 'Demand, loss, failure, and quality risk remain' } },
      { id: 'demand', label: 'Demand only', summary: 'Reduce use and losses without new supply.', values: { service: 'Can extend existing systems', cost: 'Programs, retrofits, enforcement, and adoption', ecology: 'Benefits depend on rebound and return flow', equity: 'Essential use and ability to invest vary', residual: 'Severe drought, growth, and failure can exceed savings' } },
      { id: 'integrated', label: 'Integrated portfolio', summary: 'Sequence demand, repair, reuse, operations, ecosystems, storage, and suitable supply.', values: { service: 'Addresses multiple failure modes', cost: 'Highest coordination; can avoid misfit projects', ecology: 'Joint constraints remain explicit', equity: 'Minimum service, rights, participation, and burden measures', residual: 'Local extremes and delivery failure remain' } },
    ]} />
    <FrameworkFigure chartId="food-water-plan-stress" chartType="matrix" unit="Response requirement; no outage probability" geography="Basin, utility, food-system, and facility stress framework" period="Normal operations, drought, growth, failure, and recovery" sources={sources} summary="Normal, drought, rapid-growth, and infrastructure-failure conditions require different portfolio responses and evidence gates." items={[
      { label: 'Normal operations', value: 'Efficiency and headroom', state: 'Planning condition', detail: 'Meet essential outcomes, environmental floors, quality, affordability, maintenance, loss, and reserve requirements.', gate: 'Current operations, source, treatment, demand, ecology, and service baseline' },
      { label: 'Drought', value: 'Staged allocation and backup', state: 'Stress condition', detail: 'Activate conservation, protected use, environmental floors, transfers, backup sources, curtailment, and recovery.', gate: 'Seasonal budget, live drought state, rights, priorities, triggers, and enforceability' },
      { label: 'Rapid growth', value: 'Re-test cumulative commitments', state: 'Stress condition', detail: 'Revisit yield, treatment, conveyance, energy, housing, rates, ecosystems, food, facilities, and cumulative projects.', gate: 'Localized population, facility, crop, land-use, infrastructure, and climate scenarios' },
      { label: 'Infrastructure failure', value: 'Redundancy and restoration', state: 'Stress condition', detail: 'Isolate failures, provide backup power and water, prioritize critical users, communicate, repair, and equitably restore.', gate: 'Asset, dependency, outage, emergency service, mutual-aid, and recovery evidence' },
    ]} />
    <FrameworkFigure chartId="food-water-plan-tradeoffs" chartType="matrix" unit="Separate decision dimension; no combined score" geography="Regional portfolio comparison" period="Lifecycle from planning through operation and renewal" sources={sources} summary="Reliability, cost, energy, emissions, ecosystems, and equity remain separate so that one benefit cannot silently erase a burden." items={[
      { label: 'Reliability', value: 'Service and recovery', state: 'Outcome', detail: 'Normal, drought, contamination, outage, growth, and restoration performance.', gate: 'Demand, source, system, dependency, outage, and recovery model' },
      { label: 'Cost and affordability', value: null, state: 'Outcome unavailable', detail: 'Capital, operations, maintenance, finance, rates, household burden, assistance, and cost allocation.', gate: 'Project and utility finance plus household distribution data' },
      { label: 'Energy and emissions', value: null, state: 'Outcome unavailable', detail: 'Pumping, treatment, conveyance, heating, cooling, construction, operations, and grid conditions.', gate: 'Hourly energy, grid, lifecycle, and operating scenarios' },
      { label: 'Ecosystems and water quality', value: null, state: 'Outcome unavailable', detail: 'Environmental flows, habitat, temperature, salinity, contaminants, brine, land, and cumulative effects.', gate: 'Local ecological thresholds, quality, discharge, monitoring, and validation' },
      { label: 'Equity and rights', value: null, state: 'Outcome unavailable', detail: 'Minimum service, bills, shutoffs, Tribal rights, rural wells, farmworkers, small utilities, participation, and benefit distribution.', gate: 'Comparable distributional layers and community authority' },
      { label: 'Delivery and adaptability', value: 'Institutional capacity', state: 'Outcome', detail: 'Authority, workforce, supply chain, permits, finance, community capacity, monitoring, triggers, and revision.', gate: 'Named owners, milestones, performance, public audit, and stop/go rules' },
    ]} />
  </section>

  <section id="recommendation" class="chapter-act" data-chapter-section>
    <RecommendationPanel id="food-water-plan-recommendation" title="Build regional essential-service portfolios under common standards" conclusion="Regionally tailored essential-service portfolios with national evidence, transparency, equity, and resilience standards." rationale={['Water, food, energy, industry, people, and ecosystems interact through regional physical and institutional systems.', 'A common national evidence and transparency standard makes local portfolios comparable without erasing basin differences.', 'Sequencing demand, repair, reuse, operations, ecosystems, storage, and suitable supply manages more failure modes than any single lever.']} tradeoffs={['Regional tailoring is slower and institutionally harder than one national technology target', 'Redundancy, ecological protection, affordability, and resilience can increase near-term cost', 'Allocation and siting choices create real winners, losers, rights questions, and transition needs']} residualRisks={['Severe compound drought, flood, heat, contamination, fire, energy outage, and infrastructure failure', 'Growth or climate change outside planning ranges', 'Costs, shortages, ecological loss, or household burden hidden by incomplete data or weak governance']} />
  </section>

  <section id="model" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">05 · Model-supported case</p><h2>The working view compares portfolio logic, not national water saved</h2></div>
    <StrategyWorkbench config={FOOD_WATER_PLAN_WORKBENCH} sources={sources} />
    <FrameworkFigure chartId="food-water-plan-model-contract" chartType="flow" unit="Versioned basin-food-industry model contract; quantitative portfolio results unavailable" geography="Explicit basin, utility, farm, facility, household, and ecosystem geographies" period="Historical calibration, operations, drought, growth, failure, and long-term planning" sources={sources} summary="The integrated model contract joins water quantity and quality to food, energy, industry, infrastructure, ecosystems, rights, service, affordability, governance, stress, and recovery without nationalizing basin results." items={[
      { label: 'Physical inputs', value: 'Basin and infrastructure', state: 'Required', detail: 'Climate, hydrology, recharge, storage, quality, environmental flows, assets, energy, return flow, land, and hazards.', gate: 'Common time step, spatial network, provenance, uncertainty, and mass balance' },
      { label: 'Demand and service inputs', value: 'People, food, farms, facilities', state: 'Required', detail: 'Households, utilities, crops, livestock, food, power, industry, materials, critical services, population, growth, prices, and behavior.', gate: 'Service boundary, geography, season, baseline, rebound, and distribution' },
      { label: 'Rules and portfolios', value: 'Governance and actions', state: 'Required', detail: 'Rights, allocation, rates, standards, demand, repair, reuse, operations, ecosystems, storage, new supply, curtailment, and recovery.', gate: 'Authority, enforceability, lead time, cost, performance, and limits' },
      { label: 'Outputs', value: null, state: 'Unavailable', detail: 'Service, shortage, quality, food, production, cost, bills, energy, emissions, ecosystems, rights, equity, delivery, and residual risk remain separate.', gate: 'No national average that hides a basin, household, or ecological failure' },
      { label: 'Validation and release', value: 'Versioned regional candidates', state: 'Blocked', detail: 'Mass balance, historical operations, droughts, outages, prices, service, ecological conditions, distribution, sensitivity, and independent review.', gate: 'Close basin and equity gaps; publish diagnostics and failure modes' },
    ]} />
    <EvidenceGap item={basinGap} decision="Model integrated basin reliability, food, ecosystem, and infrastructure outcomes under harmonized scenarios." missingInputs={['Basin runoff, recharge, snow, storage, withdrawals, consumption, return flows, quality, environmental flows, drought, and flood', 'Utility, farm, facility, food-system, energy, asset, rights, operations, and recovery networks', 'Common scenarios, mass balance, calibration, sensitivity, and validation']} />
    <EvidenceGap item={equityGap} decision="Test whether portfolios protect affordable essential service, rights, rural wells, workers, and small-system capacity." missingInputs={['Household burden, shutoff, service, and assistance data', 'Tribal rights and access, rural well depth and failure, farmworker exposure, and small-utility capacity', 'Project cost allocation, participation, benefits, and cumulative-burden layers']} />
    <CaveatPanel title="No nationalized basin result is published" caveats={['The working view compares qualitative portfolio coverage under stress.', 'Every quantitative result requires a named geography, period, source, return-flow method, quality boundary, and validation state.']} prohibitedInterpretations={['A national average that hides shortage, ecological loss, household burden, Tribal rights, or local failure.', 'Case-study basin or technology evidence summed into national water saved.', 'A reliability, cost, food, facility, or equity result from the current qualitative workbench.']} />
  </section>

  <section id="delivery" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">06 · Delivery</p><h2>Align implementation authority with physical systems and essential outcomes</h2></div>
    <FrameworkFigure chartId="food-water-plan-governance" chartType="flow" unit="Authority and implementation relationship; not a complete jurisdiction inventory" geography="Federal, Tribal, interstate, state, basin, utility, local, community, and project levels" period="Planning, financing, permitting, operation, drought, recovery, and revision" sources={sources} summary="National evidence and standards support regional basin and service portfolios; implementation aligns responsibility with rights, infrastructure, operations, communities, and measurable outcomes." items={[
      { label: 'National evidence and standards', value: 'Common foundation', state: 'Federal and collaborative', detail: 'Data, definitions, monitoring, research, finance, minimum service, quality, transparency, resilience, and equity standards.', gate: 'Public interoperable evidence, funding criteria, audit, and update rules' },
      { label: 'Tribal nations and rights holders', value: 'Sovereign authority and rights', state: 'Foundational', detail: 'Water rights, governance, cultural uses, knowledge, infrastructure, finance, and consent processes remain explicit.', gate: 'Rights, authority, consultation or consent requirements, and self-determined priorities' },
      { label: 'Interstate, state, and basin institutions', value: 'Allocation and system planning', state: 'Regional', detail: 'Compacts, rights, permits, environmental flows, drought rules, transfers, land use, funding, and conflict resolution.', gate: 'Physical water budget aligned to legal and institutional rules' },
      { label: 'Utilities, districts, farms, and facilities', value: 'Delivery and operations', state: 'Operational', detail: 'Assets, rates, meters, maintenance, efficiency, reuse, quality, operations, curtailment, reporting, and recovery.', gate: 'Service agreements, verified performance, triggers, and accountability' },
      { label: 'Communities, workers, and ecosystems', value: 'Outcome authority and oversight', state: 'Participatory', detail: 'Define essential outcomes, acceptable risk, local knowledge, alternatives, burdens, benefits, monitoring, and redress.', gate: 'Early participation, accessible evidence, enforceable terms, and grievance pathways' },
      { label: 'Adaptive portfolio office', value: 'Coordination and revision', state: 'Regional implementation', detail: 'Integrate plans, dependencies, finance, milestones, stress tests, performance, thresholds, audits, and corrective action.', gate: 'Named authority, budget, data access, public reporting, and stop/go powers' },
    ]} />
    <div class="delivery-gates"><article><h3>Essential-service gate</h3><p>Safe affordable minimum service, food and health continuity, critical infrastructure, and equitable recovery.</p></article><article><h3>Ecological and rights gate</h3><p>Quality, environmental flows, habitat, Tribal and other rights, downstream users, and cumulative effects.</p></article><article><h3>Adaptive-delivery gate</h3><p>Authority, finance, assets, workforce, supply chains, performance, triggers, public audit, and revision.</p></article></div>
  </section>
</article>
