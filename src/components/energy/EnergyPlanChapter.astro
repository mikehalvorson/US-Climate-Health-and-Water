---
import LinePlot from '../charts/LinePlot.astro';
import CaveatPanel from '../CaveatPanel.astro';
import ChartFrame from '../ChartFrame.astro';
import DataTable from '../DataTable.astro';
import EvidenceGap from '../EvidenceGap.astro';
import OptionComparison from '../OptionComparison.astro';
import RecommendationPanel from '../RecommendationPanel.astro';
import ViewpointGrid from '../ViewpointGrid.astro';
import FrameworkFigure from '../strategy/FrameworkFigure.astro';
import StrategyWorkbench from '../strategy/StrategyWorkbench.astro';
import { approvedStrategyChart, ENERGY_PLAN_SCENARIO_SERIES, ENERGY_PLAN_SCENARIO_TABLE, ENERGY_PLAN_WORKBENCH, STRATEGY_SOURCES, strategyGap } from '../../lib/data/strategy';

const scenarioChart = approvedStrategyChart('energy-plan-source-scenarios', 'line');
const modelGap = strategyGap('GAP-TS-003');
const sources = STRATEGY_SOURCES.energy;
---
<article class="chapter-content" data-chapter-content="energy-plan">
  <section id="current-system" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">01 · Current system</p><h2>The portfolio must deliver services, not just generating capacity</h2><p>Efficient flexible demand, diverse low-carbon supply, firm services, storage, transmission, distribution, fuels, water, land, materials, workforce, manufacturing, permitting, finance, and operations form one delivery architecture.</p></div>
    <FrameworkFigure chartId="energy-plan-architecture" chartType="flow" unit="System role; no optimized capacity quantity" geography="United States energy system" period="Present delivery through 2050 planning horizon" sources={sources} summary="The recommended architecture connects efficient flexible demand to diverse low-carbon supply through reliable grids, firm services, storage, fuels, and delivery capacity." items={[
      { label: 'Efficient flexible demand', value: 'First portfolio layer', state: 'Recommended', detail: 'Reduce avoidable energy use, shift flexible load, electrify valuable services, and protect minimum service.', gate: 'Hourly end-use, adoption, rebound, and equity evidence' },
      { label: 'Variable low-carbon supply', value: 'Diverse resource layer', state: 'Recommended', detail: 'Wind, solar, and other resources contribute energy where geography and delivery support them.', gate: 'Resource, siting, interconnection, and deliverability evidence' },
      { label: 'Firm low-carbon capability', value: 'Reliability service layer', state: 'Configuration-dependent', detail: 'Multiple technologies and fuels can provide firm energy or capacity under different constraints.', gate: 'Accredited capacity, fuel, water, outage, and cost validation' },
      { label: 'Storage and flexibility', value: 'Time-shifting layer', state: 'Configuration-dependent', detail: 'Storage, demand response, operations, and sector coupling move or reduce demand across time.', gate: 'Duration, cycling, degradation, customer, and operational evidence' },
      { label: 'Grid delivery', value: 'Network layer', state: 'Required', detail: 'Transmission, distribution, interconnection, protection, and coordination connect resources to service.', gate: 'Network, queue, corridor, equipment, permitting, and construction evidence' },
      { label: 'Delivery institutions', value: 'Enabling layer', state: 'Required', detail: 'Workforce, manufacturing, communities, Tribes, regulators, markets, finance, and public agencies determine pace and legitimacy.', gate: 'Authority, participation, supply-chain, finance, and milestone plans' },
    ]} caveats={['The architecture states system roles and delivery dependencies, not technology shares.', 'Capacity, generation, firm service, flexibility, and customer service are not interchangeable.']} />
    <ChartFrame chart={scenarioChart} unit="Terawatt-hours per year" geography="EIA: 50 states plus D.C.; NREL: contiguous United States" period="Observed history and source scenarios through 2050" sources={sources} summary="Observed EIA generation and published EIA AEO and NREL ReEDS scenario families are shown on one inspection surface while retaining separate boundaries. They are not spliced into a forecast or recommended build mix." caveats={['The series have different scopes, assumptions, and modeling purposes.', 'NGFS global pathways remain available in the workbench as context and are not relabeled as U.S. data.']}>
      <LinePlot slot="plot" series={ENERGY_PLAN_SCENARIO_SERIES} xLabel="Year" yLabel="Electricity generation" unit="TWh/year" summary="Observed United States generation and separate EIA AEO2026 and NREL Standard Scenario total-generation series." focusX={[2025, 2030, 2040, 2050]} />
      <DataTable slot="table" caption="Published energy scenario families kept separate" columns={[{ key: 'family', label: 'Source family' }, { key: 'firstYear', label: 'First year', numeric: true }, { key: 'firstValue', label: 'First value', numeric: true }, { key: 'lastYear', label: 'Last year', numeric: true }, { key: 'lastValue', label: 'Last value', numeric: true }, { key: 'unit', label: 'Unit' }, { key: 'rule', label: 'Use rule' }]} rows={ENERGY_PLAN_SCENARIO_TABLE} />
    </ChartFrame>
  </section>

  <section id="problems" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">02 · Why this is a problem</p><h2>A portfolio can look adequate in annual energy and fail in delivery</h2><p>Demand timing, firm services, network constraints, water, land, materials, equipment, construction, workforce, permits, community consent, and recovery capability determine whether modeled annual energy becomes reliable service.</p></div>
    <FrameworkFigure chartId="energy-plan-requirements" chartType="matrix" unit="Planning requirement; no performance score" geography="United States energy delivery system" period="Planning, construction, operation, and recovery" sources={sources} summary="Six requirement families must pass together before the portfolio can support a reliability or cost conclusion." items={[
      { label: 'Demand', value: 'Hourly and seasonal', state: 'Partial evidence', detail: 'Service, efficiency, electrification, flexibility, peaks, ramps, critical loads, and distribution location.', gate: 'Validated end-use adoption and hourly load shapes' },
      { label: 'Supply', value: 'Energy plus system services', state: 'Partial evidence', detail: 'Generation, firm capacity, reserves, storage duration, fuels, outages, maintenance, and restoration.', gate: 'Configuration-specific accredited capability' },
      { label: 'Grid', value: 'Network deliverability', state: 'Partial evidence', detail: 'Transmission, distribution, interconnection, protection, congestion, stability, and corridor completion.', gate: 'Power-flow, stability, queue, and construction validation' },
      { label: 'Water and land', value: 'Place-specific constraints', state: 'Partial evidence', detail: 'Withdrawal, consumption, quality, drought, siting, habitat, rights, communities, and cumulative projects.', gate: 'Facility, watershed, corridor, and ecological evidence' },
      { label: 'Materials and manufacturing', value: 'Supply-chain throughput', state: 'Partial evidence', detail: 'Transformers, conductors, fuels, minerals, factories, logistics, spares, and recycling.', gate: 'Product-level capacity, lead time, provenance, and substitution' },
      { label: 'Delivery', value: 'Institutions and execution', state: 'Partial evidence', detail: 'Authority, finance, permitting, workforce, contracting, participation, milestones, and corrective action.', gate: 'Named owners, schedules, budgets, and stop/go reviews' },
    ]} />
    <ViewpointGrid id="energy-plan-viewpoints" title="Portfolio performance is experienced through different systems" items={[
      { viewpoint: 'people_and_households', label: 'Households', problem: 'Service reliability, equipment cost, bills, housing, mobility, and access vary by customer and place.', evidenceState: 'data_gap', consequence: 'No household bill impact is authorized until tariffs, adoption, financing, housing, and distribution costs are modeled.' },
      { viewpoint: 'workers_and_operators', label: 'Workers and operators', problem: 'Rapid construction and new operating systems change safety, skills, staffing, and regional livelihoods.', evidenceState: 'qualitative_evidence', consequence: 'Training, standards, bargaining, transition support, and operator participation belong in delivery.' },
      { viewpoint: 'host_communities_and_tribes', label: 'Host communities and Tribes', problem: 'Projects affect land, waters, heritage, rights, housing, local services, benefits, and cumulative burdens.', evidenceState: 'qualitative_evidence', consequence: 'Early authority, consent where applicable, benefits, alternatives, and enforceable terms are required.' },
      { viewpoint: 'national_security_and_supply_chains', label: 'Supply chains and security', problem: 'Concentrated equipment, fuel, mineral, software, and logistics dependencies can delay or disrupt delivery.', evidenceState: 'qualitative_evidence', consequence: 'Diversity, standards, inventories, manufacturing, cybersecurity, and recovery plans reduce exposure.' },
    ]} />
  </section>

  <section id="choices" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">03 · Choices</p><h2>Robustness means keeping service through multiple plausible failures</h2></div>
    <OptionComparison id="energy-plan-options" title="Portfolio architectures under common delivery dimensions" question="Which architecture best manages demand, supply, grid, environmental, and execution uncertainty?" dimensions={[{ id: 'benefit', label: 'Main benefit' }, { id: 'dependency', label: 'Critical dependency' }, { id: 'delivery', label: 'Delivery burden' }, { id: 'residual', label: 'Residual risk' }, { id: 'evidence', label: 'Evidence boundary' }]} options={[
      { id: 'supply-led', label: 'Supply-led expansion', summary: 'Build generation to meet forecast demand.', values: { benefit: 'Adds energy and selected capacity', dependency: 'Forecast, siting, fuel, interconnection, grid', delivery: 'High project and network build', residual: 'Peak, flexibility, affordability, and delivery mismatch', evidence: 'No optimized mix authorized' } },
      { id: 'demand-led', label: 'Demand-led strategy', summary: 'Prioritize efficiency and flexible electrification.', values: { benefit: 'Reduces avoidable build and operating pressure', dependency: 'Customer adoption, controls, tariffs, buildings', delivery: 'Distributed program and equipment delivery', residual: 'Firm supply and network needs remain', evidence: 'Hourly adoption model required' } },
      { id: 'single-path', label: 'Single technology path', summary: 'Concentrate investment in one favored supply family.', values: { benefit: 'Simpler standardization', dependency: 'One resource, supply chain, siting pattern, and performance thesis', delivery: 'Concentrated bottlenecks', residual: 'Common-mode failure and regional mismatch', evidence: 'Technology role is configuration-specific' } },
      { id: 'diversified', label: 'Diversified architecture', summary: 'Pair efficient flexible demand with diverse low-carbon supply and grid delivery.', values: { benefit: 'Covers more failure modes', dependency: 'Coordination and disciplined sequencing', delivery: 'Broad workforce, manufacturing, grid, and institutional effort', residual: 'High-demand and compound disruptions', evidence: 'Recommended design, not optimum' } },
    ]} />
    <FrameworkFigure chartId="energy-plan-robustness" chartType="matrix" unit="Qualitative response requirement; no probability or reliability score" geography="United States energy-system stress framework" period="Operations and buildout through 2050" sources={sources} summary="The diversified architecture changes emphasis under high demand, delayed transmission, constrained firm capacity, supply-chain delay, drought, and extreme weather; every response remains gated by a validated system model." items={[
      { label: 'High demand', value: 'Widen demand and supply range', state: 'Stress case', detail: 'Accelerate efficiency, flexibility, interconnection, firm options, and distribution readiness.', gate: 'Hourly demand and resource-adequacy model' },
      { label: 'Delayed transmission', value: 'Sequence around network reality', state: 'Stress case', detail: 'Increase regional diversity, local flexibility, storage, reconductoring, and deliverable commitments.', gate: 'Corridor, queue, power-flow, and construction model' },
      { label: 'Constrained firm capacity', value: 'Protect essential reliability services', state: 'Stress case', detail: 'Test demand response, storage duration, fuels, firm technologies, imports, and emergency operations.', gate: 'Accredited capacity and chronological operations' },
      { label: 'Supply-chain delay', value: 'Diversify equipment and schedule', state: 'Stress case', detail: 'Standardize where useful, qualify alternatives, expand manufacturing, hold spares, and stage commitments.', gate: 'Product-level lead time and manufacturing evidence' },
      { label: 'Drought', value: 'Reduce water-linked common modes', state: 'Stress case', detail: 'Protect water-efficient operation, fuel logistics, cooling alternatives, demand response, and basin coordination.', gate: 'Plant, watershed, temperature, quality, and drought data' },
      { label: 'Extreme weather', value: 'Harden and recover', state: 'Stress case', detail: 'Weatherize, sectionalize, island critical services, stock spares, coordinate communications, and rehearse restoration.', gate: 'Geospatial hazard, asset, dependency, outage, and recovery model' },
    ]} />
  </section>

  <section id="recommendation" class="chapter-act" data-chapter-section>
    <RecommendationPanel id="energy-plan-recommendation" title="Diversify supply, shape demand, and accelerate delivery together" conclusion="A diversified low-carbon portfolio paired with efficient flexible demand and accelerated grid delivery." rationale={['Diversity reduces exposure to single-resource, fuel, equipment, geography, and timing failures.', 'Efficient flexible demand can lower avoidable build pressure while protecting valuable electrification.', 'Grid, manufacturing, workforce, permitting, and community delivery determine whether resource potential becomes reliable service.']} tradeoffs={['Coordination is harder than a single-technology narrative', 'Redundancy, resilience, and early delivery capacity can add near-term cost', 'Siting and construction create real local burdens that require alternatives, participation, and enforceable mitigation']} residualRisks={['Demand growth beyond the planning range', 'Common-mode extreme weather, cyber, fuel, equipment, or water disruptions', 'Delivery delays, cost overruns, inequitable bills, or benefits that the current framework cannot quantify']} />
  </section>

  <section id="model" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">05 · Model-supported case</p><h2>Published scenarios can be switched; the integrated model cannot be impersonated</h2></div>
    <StrategyWorkbench config={ENERGY_PLAN_WORKBENCH} sources={sources} />
    <FrameworkFigure chartId="energy-plan-model-contract" chartType="flow" unit="Versioned model contract; quantitative strategy outputs unavailable" geography="United States energy system with explicit global context seams" period="Hourly operations, annual investment, and delivery milestones through 2050" sources={sources} summary="The integrated model contract requires versioned inputs, equations, outputs, validation, and release gates before any least-cost, reliability, household-bill, or final-build claim." items={[
      { label: 'Inputs', value: 'Versioned evidence', state: 'Required', detail: 'Hourly service demand, adoption, resources, networks, technologies, fuels, water, land, materials, costs, outages, workforce, permits, and equity.', gate: 'Compatible units, geographies, periods, provenance, and uncertainty' },
      { label: 'Equations', value: 'Transparent modules', state: 'Required', detail: 'Energy balances, chronological dispatch, capacity accreditation, networks, investment, retirement, delivery constraints, emissions, and distributional accounting.', gate: 'Dimensional checks, public documentation, and null-preserving rules' },
      { label: 'Outputs', value: null, state: 'Unavailable', detail: 'Build, retirements, generation, reliability, emissions, costs, bills, land, water, materials, health, jobs, and residual risk remain separate.', gate: 'No one-number clean score or unsupported optimum' },
      { label: 'Validation', value: 'Historical and operational tests', state: 'Required', detail: 'Backcast demand, dispatch, prices, outages, queues, construction, costs, and recovery; compare multiple tools where compatible.', gate: 'Named thresholds, residuals, sensitivity, and failure cases' },
      { label: 'Release', value: 'Candidate versions', state: 'Blocked', detail: 'Publish code, data bindings, assumptions, scenarios, diagnostics, provenance, uncertainty, and known limitations.', gate: 'Independent review and reproducible runs' },
    ]} />
    <EvidenceGap item={modelGap} decision="Run a reproducible integrated energy scenario and distinguish it from source-model output." missingInputs={['Validated hourly demand, operations, network, resource-adequacy, and investment modules', 'Configuration-specific cost, water, land, material, health, workforce, and delivery coefficients', 'Household tariff, adoption, financing, and distributional model']} />
    <CaveatPanel title="No finished national energy optimization is published" caveats={['The working view switches source scenarios and qualitative stresses only.', 'Published scenario families retain their own models, scopes, and endpoints.']} prohibitedInterpretations={['A least-cost optimum, reliability proof, household bill impact, or final 2050 build mix.', 'AEO, NREL, or NGFS presented as the dashboard recommendation.', 'Annual energy used as proof of hourly, network, or recovery adequacy.']} />
  </section>

  <section id="delivery" class="chapter-act" data-chapter-section>
    <div class="act-heading"><p class="section-kicker">06 · Delivery</p><h2>Advance phases only when evidence and execution gates clear</h2></div>
    <FrameworkFigure chartId="energy-plan-roadmap" chartType="flow" unit="Delivery phase and release gate; dates are not forecasts" geography="United States with regional and local implementation" period="Now, scale, integration, and adaptive renewal through 2050" sources={sources} summary="The roadmap begins with no-regrets demand, grid, manufacturing, and community capacity; scales proven portfolios; integrates operations; and revises through monitored gates." items={[
      { label: 'Now · establish capacity', value: '0–5 years', state: 'Phase 1', detail: 'Efficiency, flexible-load standards, interconnection reform, grid upgrades, manufacturing, workforce, community capacity, and critical resilience.', gate: 'Named owners, baselines, funding, participation, and milestone evidence' },
      { label: 'Scale · build diversified portfolios', value: '5–15 years', state: 'Phase 2', detail: 'Deliver regional generation, storage, firm options, transmission, distribution, clean fuels, electrified services, and retirement transitions.', gate: 'Demonstrated projects, network deliverability, supply chains, and protections' },
      { label: 'Integrate · operate as one system', value: '10–25 years', state: 'Phase 3', detail: 'Coordinate markets, planning, forecasting, flexibility, reserves, fuel and water risk, cyber, mutual aid, and restoration.', gate: 'Chronological reliability, stress, and recovery validation' },
      { label: 'Renew · revise under evidence', value: 'Continuous', state: 'Adaptive phase', detail: 'Update demand, assets, climate, costs, technology, communities, performance, and residual risks; stop or redirect failing paths.', gate: 'Public monitoring, independent audit, and decision triggers' },
    ]} />
    <div class="delivery-gates"><article><h3>Portfolio gate</h3><p>Service, hourly adequacy, network deliverability, fuel, water, land, materials, emissions, and recovery.</p></article><article><h3>People gate</h3><p>Bills, access, jobs, safety, housing, participation, Tribal rights, community benefits, and cumulative burdens.</p></article><article><h3>Execution gate</h3><p>Authority, finance, permits, supply chain, workforce, schedule, performance, audit, and corrective action.</p></article></div>
  </section>
</article>
