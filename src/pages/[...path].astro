---
import RouteLayout from '../layouts/RouteLayout.astro';
import { hrefForRoute, STORY_ANCHORS } from '../lib/navigation/shell';
import { CANONICAL_REGISTRIES } from '../lib/registry/store';
import { ROUTES } from '../lib/registry/routes';
import type { RouteDefinition } from '../lib/registry/types';

interface Props { route: RouteDefinition }

export function getStaticPaths() {
  return ROUTES.filter((route) => route.path !== '/').map((route) => ({
    params: { path: route.path.slice(1) },
    props: { route },
  }));
}

const { route } = Astro.props;
const base = import.meta.env.BASE_URL;
const statusCopy = {
  'current-system': ['Observed baseline', 'The evidence adapter is registered. Metrics and the system figure remain unavailable here until this chapter’s data identities, units, periods, geographies, and boundaries pass its vertical-slice gate.'],
  problems: ['Multiple viewpoints', 'The completed chapter will show burdens across affected people, operators, producers, communities, public health, ecosystems, governments, and future generations without inventing evidence for this shell.'],
  choices: ['Comparable strategies', 'Options will be compared on a common set of benefits, costs, lead times, dependencies, residual risks, and evidence maturity before a recommendation is made.'],
  recommendation: ['Advocated design', 'A recommendation will appear only with a traceable reasoning chain, explicit tradeoffs, and a clear statement of what the evidence does not establish.'],
  model: ['Reference · recommended · stress', 'No strategy-model output is authorized in this shell. Pending inputs stay null, model-family seams stay visible, and unavailable results are not converted to estimates.'],
  delivery: ['Sequence and review gates', 'The delivery view will connect authority, infrastructure, workforce, manufacturing, community participation, finance, measures, and stop/go gates.'],
} as const;
---
<RouteLayout route={route}>
  {route.routeKind === 'story' ? (
    <div class="shell-sections" aria-label={`${route.label} chapter publication gates`}>
      {STORY_ANCHORS.map((anchor, index) => {
        const copy = statusCopy[anchor.id];
        return (
          <section id={anchor.id} class="shell-section" data-shell-section>
            <div class="shell-section__number">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <p class="section-kicker">{anchor.label}</p>
              <h2>{copy[0]}</h2>
              <p>{copy[1]}</p>
              <span class="publication-gate">Publication gate not yet cleared</span>
            </div>
          </section>
        );
      })}
      <aside class="method-link-card">
        <p>Every unavailable result is deliberate.</p>
        <a href={hrefForRoute('/methods', base)}>Inspect the current evidence and gap foundation →</a>
      </aside>
    </div>
  ) : (
    <div class="methods-shell">
      <section class="shell-notice" aria-labelledby="methods-status-title">
        <p class="section-kicker">Inspection surface · shell state</p>
        <h2 id="methods-status-title">The ledgers exist; the searchable public methods workspace arrives in Step 12.</h2>
        <p>The canonical layer already preserves collisions, confidence, source coverage, model boundaries, missing access dates, pending parameters, and every open research item.</p>
      </section>
      <dl class="registry-summary" aria-label="Canonical evidence registry summary">
        <div><dt>Sources</dt><dd>{CANONICAL_REGISTRIES.source?.length ?? 0}</dd></div>
        <div><dt>Claims</dt><dd>{CANONICAL_REGISTRIES.claim?.length ?? 0}</dd></div>
        <div><dt>Datasets</dt><dd>{CANONICAL_REGISTRIES.dataset?.length ?? 0}</dd></div>
        <div><dt>Open items</dt><dd>{CANONICAL_REGISTRIES.open_item?.length ?? 0}</dd></div>
      </dl>
    </div>
  )}
</RouteLayout>
